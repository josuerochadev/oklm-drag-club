# URL publique du site (sans slash final)
# En production Vercel, VERCEL_URL est injecté automatiquement comme fallback.
NEXT_PUBLIC_SITE_URL=https://oklm-drag-club.fr

# Webhook de déploiement Vercel (utilisé par /api/rebuild)
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# Secret partagé pour protéger /api/rebuild
REBUILD_SECRET=changeme
